{
  "manifestVersion": 5,
  "id": "image-bench.canny",
  "name": "Canny Edges",
  "version": "1.0.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "cannyPanel",
      "label": {"default": "Canny Edges"},
      "minimumSize": {"width": 200, "height": 260},
      "maximumSize": {"width": 2000, "height": 2000},
      "preferredDockedSize": {"width": 280, "height": 420},
      "preferredFloatingSize": {"width": 280, "height": 420}
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "plugin"
  }
}
